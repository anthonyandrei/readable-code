{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT, 'hooks/document-code.cjs'))\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT, 'hooks/document-code.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT, 'hooks/document-code.cjs'))\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
